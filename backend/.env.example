# Local development: run ../scripts/local_database.py using backend/.venv/bin/python first.
DB_MODE=local
DATABASE_URL=postgresql+pg8000://bboard@127.0.0.1:55432/bboard
CORS_ORIGINS=http://localhost:6600,http://127.0.0.1:6600

# Self-hosted production (see README.md#self-hosting). DB_MODE=postgres turns on production mode.
# DB_MODE=postgres
# DATABASE_URL=postgresql+pg8000://bboard_runtime:PASSWORD@HOST:5432/bboard
# DATABASE_TLS_CA=/path/to/provider-ca.pem
# BBOARD_EDGE_TOKEN=long-random-secret-your-proxy-sends-as-X-Bboard-Edge
# BBOARD_TRUSTED_PROXIES=10.0.0.0/8
# BBOARD_SITE_URL=https://boards.example.com
# BBOARD_SITE_HOSTS=boards.example.com
# BBOARD_MCP_HOSTS=boards.example.com
# CORS_ORIGINS=https://boards.example.com
